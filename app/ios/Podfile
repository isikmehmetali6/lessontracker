# Minimum iOS version for Google ML Kit
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# iOS 26 simülatörleri yalnızca arm64 çalıştırır, Google ML Kit'in hazır
# framework'lerinde ise arm64-simülatör dilimi yok. Simülatör derlemesinde
# ML Kit bağlanmaz, plugin kaynakları derlenmez ve yerlerine
# Runner/MLKitSimulatorStubs.m içindeki yedek plugin'ler kullanılır (OCR
# simülatörde `UNAVAILABLE` döner). Gerçek cihaz derlemesi etkilenmez.
MLKIT_BINARY_FRAMEWORKS = %w[
  MLImage MLKitCommon MLKitTextRecognition MLKitTextRecognitionCommon MLKitVision
].freeze
MLKIT_PLUGIN_TARGETS = %w[google_mlkit_commons google_mlkit_text_recognition].freeze

target 'Runner' do
  use_frameworks! :linkage => :static
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      if MLKIT_PLUGIN_TARGETS.include?(target.name)
        config.build_settings['EXCLUDED_SOURCE_FILE_NAMES[sdk=iphonesimulator*]'] = '*.m'
      end
    end
  end
  
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['CODE_SIGN_IDENTITY'] = ''
  end
end

# Pods-Runner xcconfig'leri post_install'dan sonra yazıldığı için burada
# düzenlenir: ML Kit podspec'lerinin eklediği simülatör arm64 dışlaması
# kaldırılır ve simülatör için ML Kit framework'leri bağlanmaz.
post_integrate do |installer|
  support_dir = File.join(installer.sandbox.root, 'Target Support Files', 'Pods-Runner')
  Dir.glob(File.join(support_dir, 'Pods-Runner.*.xcconfig')).each do |path|
    lines = File.readlines(path)
    lines.reject! do |line|
      line.start_with?(
        'EXCLUDED_ARCHS[sdk=iphonesimulator*]',
        'OTHER_LDFLAGS[sdk=iphonesimulator*]',
        'CLANG_MODULES_AUTOLINK[sdk=iphonesimulator*]'
      )
    end
    ldflags = lines.find { |line| line.start_with?('OTHER_LDFLAGS = ') }
    if ldflags
      sim_ldflags = ldflags.sub('OTHER_LDFLAGS = ', 'OTHER_LDFLAGS[sdk=iphonesimulator*] = ')
      MLKIT_BINARY_FRAMEWORKS.each { |f| sim_ldflags = sim_ldflags.gsub(" -framework \"#{f}\"", '') }
      lines << sim_ldflags
    end
    # GeneratedPluginRegistrant plugin başlıkları üzerinden MLKitVision'ı
    # modül olarak içe aktarır; clang bu durumda framework'ü otomatik bağlar.
    # Simülatörde kapatılır — pod framework'leri OTHER_LDFLAGS'ta zaten açık.
    lines << "CLANG_MODULES_AUTOLINK[sdk=iphonesimulator*] = NO\n"
    File.write(path, lines.join)
  end
end
